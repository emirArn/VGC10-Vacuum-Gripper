    <link name="${tf_prefix}conveyor_belt">
      <inertial>
        <origin rpy="0 0 0" xyz="0.651237 0.086681 0.615798"/>
        <mass value="26.689341"/>
        <inertia ixx="3.942" ixy="-0.008312" ixz="-0.009881" iyy="2.162" iyz="0.06187" izz="2.363"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/conveyorbelt.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/conveyorbelt.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <!-- GERÇEK YAN KORKULUKLAR (14 Ağu 2026, bir çarpışmadan sonra eklendi).
           conveyorbelt.stl korkulukları bandın sadece 3.1 mm üstünde bitiriyor
           (link z 0.8549). GERÇEKTE korkulukların üstü yerden 0.900 m, yani
           bandın (0.845) 55 mm üstünde. Model 52 mm alçak gösterdiği için
           MoveIt korkulukları görmüyordu ve kol onlara çarptı.

           Bu kutular mesh'in bıraktığı boşluğu dolduruyor: bandın üstünden
           (link z 0.8518 = dünya 0.845) korkuluk üstüne (link z 0.9068 =
           dünya 0.900) kadar, yükseklik 0.055.
           Ayak izi mesh'ten ölçüldü (yukarı bakan yüzeyler, link z 0.8549):
             sol  x 0.4903..0.5187   y -0.3824..0.4176
             sağ  x 0.7803..0.8087   y -0.3824..0.5176
           Profil genişliği iki tarafta da 28.4 mm.

           Link frame ile dünya arasında 6.8 mm var (base_to_conveyorbelt
           origin z = -0.0068); buradaki bütün z'ler LINK frame'inde.

           SADECE collision, visual YOK: bunlar mesh'in eksiğini kapatan
           çarpışma hacimleri, ayrı bir fiziksel parça değil; RViz'de mesh'in
           üstüne binen kutular olarak görünmeleri kafa karıştırır.

           Ayrı bir link değil, conveyor_belt'in parçası: SRDF'teki mevcut
           çarpışma çiftleri (upper_arm, forearm, wrist_*, suction_cup
           denetleniyor) olduğu gibi geçerli kalsın diye. -->
      <collision>
        <origin rpy="0 0 0" xyz="0.5045 0.0176 0.8793"/>
        <geometry>
          <box size="0.0284 0.8000 0.0550"/>
        </geometry>
      </collision>
      <collision>
        <origin rpy="0 0 0" xyz="0.7945 0.0676 0.8793"/>
        <geometry>
          <box size="0.0284 0.9000 0.0550"/>
        </geometry>
      </collision>
    </link>

    <link name="${tf_prefix}stackable_bin">
      <inertial>
        <origin xyz="0.81318 1.30332 0.489851" rpy="0 0 0"/>
        <mass value="15.033826"/>
        <inertia 
          ixx="2.508"
          ixy="8.586e-9"
          ixz="-0.09262"
          iyy="1.966"
          iyz="1.39871e-7"
          izz="1.231"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/stackable_bin.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
    
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/stackable_bin.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint tanımları -->
    <joint name="${tf_prefix}table_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${tf_prefix}table" />
    </joint>

    <!-- Linear axis joint - bu joint'in tam tanımı burada olmalı -->
    <joint name="${tf_prefix}base_to_robot_mount" type="prismatic">
      <parent link="${tf_prefix}table"/>
      <child link="${tf_prefix}robot_mount"/>
      <origin xyz="-0.158 0.115 0.58635" rpy="0 0 0" />
      <axis xyz="0.0 1.0 0.0"/>
      <limit effort="1000" lower="0.05" upper="1.95" velocity="1.25"/>
      <dynamics damping="100.0" friction="50.0"/>
    </joint>

    <!-- <joint name="${tf_prefix}base_to_chassis" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}chassis"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint> -->

    <!-- <joint name="${tf_prefix}base_to_platform" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}platform"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="${tf_prefix}platform_to_windowlessdoor" type="fixed">
      <parent link="${tf_prefix}platform"/>
      <child link="${tf_prefix}windowlessdoor"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="${tf_prefix}platform_to_windowdoor" type="fixed">
      <parent link="${tf_prefix}platform"/>
      <child link="${tf_prefix}windowdoor"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint> -->

    <joint name="${tf_prefix}base_to_alumuniumtable" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}alumunium_table"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="${tf_prefix}base_to_screwdriver" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}screwdriver"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="${tf_prefix}base_to_screw_feeder" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}screw_feeder"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Konveyör yüksekliği (14 Ağu 2026, ŞERİT METREYLE doğrulandı).
         Hizalama BANT YÜZEYİNE göre yapılır: kavrama da çarpışma da orada olur.

         Mesh'in bant yüzeyi (üstten görünen yüzey, 5 mm ızgarayla ölçüldü;
         bandın ortasında x 0.56..0.745, y -0.30..0.40 tamamen düz) bu joint
         sıfırken z = 0.8518'de. Gerçek bant yerden 0.845 m.
             0.845 - 0.8518 = -0.0068

         Dünya z=0'ın yer olduğu bağımsız doğrulandı: kol TOUCH pozundayken
         TF kap ağzını 0.9995'te gösterdi, yerden şerit metre 1.00-1.01 m.

         MESH GERÇEK KONVEYÖRÜ TAM TEMSİL ETMİYOR, dikkat:
           - Mesh'te yan raylar bandın 3.1 mm üstünde (z 0.8549 ham).
             GERÇEKTE raylar yerden 0.900, yani bandın 55 mm üstünde.
             Model bu korkulukları 52 mm alçak gösteriyor; MoveIt gerçek
             korkulukları GÖRMÜYOR. Kol banda yandan yaklaşırsa çarpabilir.
             Kalıcı çözüm: korkulukları ayrı bir çarpışma kutusu olarak ekle.
           - Mesh'in altı bu haliyle z = -0.0318'e iniyor (yerin altı). Sadece
             görsel; alt şase de gerçekle birebir değil.

         TARİHÇE: bu değer bir ara +0.0451 yapıldı, çünkü hizalama YAN RAY
         ölçümünden (0.900) türetilmişti ve mesh'in ray-bant mesafesinin
         gerçeği yansıttığı varsayılmıştı. Yansıtmıyor: ray hizalandı ama
         bant 51 mm yukarı çıktı, nokta bulutu konveyörün içine gömülmüş
         göründü ve suction_cup ile conveyor_belt çarpışmaya başladı. -->
    <joint name="${tf_prefix}base_to_conveyorbelt" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}conveyor_belt"/>
      <origin xyz="0 0 -0.0068" rpy="0 0 0"/>
    </joint>

    <joint name="${tf_prefix}bin_fixed" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}stackable_bin"/>
      <origin xyz="1.028923 1.685202 0.0" rpy="0 0 1.5707963"/>
    </joint>

    <xacro:if value="${generate_linear_axis_control_tag}">
    <ros2_control name="LinearAxisHardwareInterface" type="system">
      <xacro:if value="$(arg use_fake_hardware)">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="state_following_offset">0.0</param>
          <param name="calculate_dynamics">true</param>
          <param name="state_update_frequency">100.0</param>
        </hardware>
      </xacro:if>
      <xacro:unless value="$(arg use_fake_hardware)">
        <hardware>
          <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
          <param name="joint_commands_topic">/linear_axis/target_position_cmd</param>
          <!-- MUST NOT be /joint_states. The joint_state_broadcaster publishes this
               joint's state interface back onto /joint_states at ~400 Hz, so reading
               state from there makes TopicBasedSystem consume its OWN output: the
               echo outnumbers the adapter's real measurement 5:1 and the state stays
               latched at initial_value (1.0 m), which is exactly the 0.500001 m
               position error the trajectory controller aborted on. The adapter
               publishes the measured rail position here instead, and the broadcaster
               still forwards the (now correct) state to /joint_states for everyone
               else. -->
          <param name="joint_states_topic">/linear_axis/joint_states</param>
          <param name="sum_wrapped_joint_states">true</param>
        </hardware>
      </xacro:unless>
      
      <joint name="ur10e_base_to_robot_mount">
        <command_interface name="position"/>
        <command_interface name="velocity">
          <param name="min">-1.25</param>
          <param name="max">1.25</param>
        </command_interface>
        <state_interface name="position">
            <param name="initial_value">1.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
    </xacro:if>

    <transmission name="${tf_prefix}linear_axis_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${tf_prefix}base_to_robot_mount">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${tf_prefix}linear_axis_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>


    <!--This will create the specific robot. Set generate_ros2_control_tag false if working with real robot, true for sim-->
    <xacro:ur_robot
      name="${tf_prefix}${ur_type}"
      tf_prefix="${ur_type}_"
      parent="${tf_prefix}robot_mount"
      joint_limits_parameters_file="${joint_limits_parameters_file}"
      kinematics_parameters_file="${kinematics_parameters_file}"
      physical_parameters_file="${physical_parameters_file}"
      visual_parameters_file="${visual_parameters_file}"
      generate_ros2_control_tag="false" 
      sim_ignition="${sim_ignition}"
    >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ur_robot>

    <xacro:if value="${sim_ignition}">
      <gazebo>
        <plugin filename="libgz-sim-joint-state-publisher-system.so" name="gz::sim::systems::JointStatePublisher">
          <topic>/sim_joint_states</topic>
        </plugin>
      </gazebo>
    </xacro:if>


  </xacro:macro>

  

</robot>
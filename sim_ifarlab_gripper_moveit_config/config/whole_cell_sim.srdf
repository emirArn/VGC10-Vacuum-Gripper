    <disable_collisions link1="barrier_closekabinet_link" link2="sim_ifarlab_ray_link" reason="Adjacent"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="sim_kawasaki_base_link" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="sim_kawasaki_link1" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="sim_kawasaki_link2" reason="Never"/>

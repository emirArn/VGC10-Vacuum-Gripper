    <!-- The Kawasaki SICK camera's collision shell (rs005l_macro.xacro). It is
         rigidly fixed to link7, which is rigidly fixed to link6, so their relative
         pose never changes and checking those pairs only ever produces a permanent
         self-collision. link5 and inboard links are deliberately NOT listed: the
         shell reaches past link7 and folding it into the arm is a real collision. -->
    <disable_collisions link1="sim_kawasaki_camera_link" link2="sim_kawasaki_link7" reason="Adjacent"/>
    <disable_collisions link1="sim_kawasaki_camera_link" link2="sim_kawasaki_link6" reason="Adjacent"/>
    <!-- Cable channel cradle bolted to the Kawasaki forearm (rs005l_macro.xacro).
         Only the two links it is physically mounted between are disabled: link3, its
         parent, whose mesh it overlaps outright, and link4, which it clears by 5.0 mm,
         inside every collision tolerance and link padding on offer. The bracket is bolted
         across that elbow in reality. Everything else is left ENABLED on purpose.
         Nearest approaches over the full joint ranges: link2 2.3 cm (swept joint3),
         link5 18.6 cm, link6 18.5 cm, link7 2.2 cm and camera_link 1.0 cm at extreme
         wrist poses. Those last two are exactly the collisions this link was added to
         catch. -->
    <disable_collisions link1="sim_kawasaki_kawa_cable_channel" link2="sim_kawasaki_link3" reason="Adjacent"/>
    <disable_collisions link1="sim_kawasaki_kawa_cable_channel" link2="sim_kawasaki_link4" reason="Always"/>
</robot>

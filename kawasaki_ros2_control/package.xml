<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kawasaki_ros2_control</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Control hardware interface plugin for Kawasaki RS005L robot
    using the SIR robot communication library.
  </description>
  <maintainer email="cshyilmaz@gmail.com">Cem Suha Yilmaz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>sir_robot_ros_interface</depend>
  <depend>eigen3_cmake_module</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/kawasaki_ros2_control.xml"/>
  </export>
</package>

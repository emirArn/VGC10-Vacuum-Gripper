<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rs005l_ros2_control" params="
    name
    use_fake_hardware:=false
    tf_prefix
    generate_ros2_control_tag:=true
    sim_ignition:=false
    fake_sensor_commands:=false
    robot_ip:=192.168.3.7
    robot_port:=11111
    cmd_threshold_rad:=0.001
    ">

    <ros2_control name="${name}" type="system">  
      <hardware>
        <xacro:if value="${sim_ignition}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <!-- Real Kawasaki RS005L hardware via SIR TCP/IP protocol -->
        <xacro:unless value="${sim_ignition or use_fake_hardware}">
          <plugin>kawasaki_ros2_control/KawasakiHardwareInterface</plugin>
          <param name="robot_ip">${robot_ip}</param>
          <param name="robot_port">${robot_port}</param>
          <param name="cmd_threshold_rad">${cmd_threshold_rad}</param>
        </xacro:unless>
      </hardware>

      <!-- AGV prismatic joint (world_to_agv):
           - fake hardware → rs005l GenericSystem altında (7-DOF tek system)
           - gerçek hardware → ota_system TopicBasedSystem altında
             (KawasakiHardwareInterface sadece 6 eklem kabul eder) -->
      <xacro:if value="${use_fake_hardware}">
        <joint name="world_to_agv">
          <command_interface name="position"/>
          <command_interface name="velocity">
            <param name="min">-1.25</param>
            <param name="max">1.25</param>
          </command_interface>
          <state_interface name="position">
              <param name="initial_value">1.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:if>

      <!-- orjinalinde command interface effort bunu sormak lazım -->
      <joint name="${tf_prefix}joint1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${tf_prefix}joint2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${tf_prefix}joint3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${tf_prefix}joint4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${tf_prefix}joint5">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${tf_prefix}joint6">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>

  <!-- cem.sdf: ifarlab_ray model pose = "0 0 0 0 0 0" → world origin -->
  <joint name="sim_ifarlab_ray_joint" type="fixed">
    <parent link="world"/>
    <child link="sim_ifarlab_ray_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- AGV başlangıç konumu: cem.sdf spawn pozisyonundan okundu
         x=-2.301949  y=0.135135131  z=0.17  yaw=1.570796 (90°)
         axis 1 0 0 = joint frame local X = yaw 90° nedeniyle world +Y yönü
         Bu eksende AGV ileri/geri hareket eder (ray üzerinde kayar) -->
  <joint name="sim_world_to_agv" type="prismatic">
    <parent link="sim_ifarlab_ray_link"/>
    <child link="sim_ota_base_link"/>
    <origin rpy="0 0 1.570796" xyz="-2.301959 0.135135131 0.165"/>
    <axis xyz="1.0 0.0 0.0"/>
    <limit effort="1000" lower="0.0" upper="2.0" velocity="1.25"/>
    <dynamics damping="100.0" friction="50.0"/>
  </joint>
  <joint name="sim_base2manipulatorbase" type="fixed">
    <parent link="sim_ota_base_link"/>
    <child link="sim_manipulator_base_link"/>
    <origin rpy="0 0 0" xyz="0.001 -0.26 0.212"/>
  </joint>
  <ros2_control name="ota_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Right wheel -->
    <joint name="sim_wheel_right_base">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Left wheel -->
    <joint name="sim_wheel_left_base">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="sim_world_to_agv">
      <command_interface name="position"/>
      <command_interface name="velocity">
        <param name="min">-1.25</param>
        <param name="max">1.25</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <link name="sim_ota_ir_link">
    <!-- Inertial -->
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001666" ixy="0" ixz="0" iyy="0.001666" iyz="0" izz="0.001666"/>
    </inertial>
    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <!-- Gazebo sensor plugin (IR/Range) -->
    <gazebo reference="sim_ota_ir_link">
      <sensor name="sim_ota_ir_sensor" type="ray">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <pose>-0.1 0 0 0 0 0</pose>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </link>
  <joint name="sim_ota_ir_joint" type="fixed">

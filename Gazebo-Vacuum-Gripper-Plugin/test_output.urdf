      <geometry>
        <box size="0.187945 0.190701 0.103"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01957327192110477" ixy="0.0" ixz="0.0" iyy="0.01913846027169616" iyz="0.0" izz="0.029870902395800928"/>

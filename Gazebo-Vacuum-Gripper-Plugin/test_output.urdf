  <link name="sim_manipulator_base_link">
    <origin rpy=" 0 0 0" xyz="0 0 0"/>
    <visual>
      <origin rpy=" 0 0 0" xyz="0 0 -0.0"/>
      <geometry>
        <box size="0.187945 0.190701 0.103"/>

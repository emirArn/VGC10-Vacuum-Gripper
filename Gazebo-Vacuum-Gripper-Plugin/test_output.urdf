  <!-- Joint tanımları -->
  <joint name="sim_ur10e_table_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0 0"/>
    <parent link="world"/>
    <child link="sim_ur10e_table"/>
  </joint>
  <!-- CHASSIS JOINT - devre dışı bırakıldı
    <joint name="${tf_prefix}base_to_chassis" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}chassis"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    -->
  <joint name="sim_ur10e_base_to_platform" type="fixed">
    <parent link="world"/>
    <child link="sim_ur10e_platform"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="sim_ur10e_platform_to_windowlessdoor" type="fixed">
    <parent link="sim_ur10e_platform"/>
    <child link="sim_ur10e_windowlessdoor"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="sim_ur10e_platform_to_windowdoor" type="fixed">
    <parent link="sim_ur10e_platform"/>
    <child link="sim_ur10e_windowdoor"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Linear axis joint - bu joint'in tam tanımı burada olmalı -->
  <joint name="sim_ur10e_base_to_robot_mount" type="prismatic">
    <parent link="sim_ur10e_table"/>
    <child link="sim_ur10e_robot_mount"/>
    <origin rpy="0 0 0" xyz="-0.158 0.115 0.58635"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="1000" lower="0.05" upper="1.95" velocity="1.25"/>
    <dynamics damping="100.0" friction="50.0"/>
  </joint>
  <joint name="sim_ur10e_base_to_alumuniumtable" type="fixed">
    <parent link="world"/>
    <child link="sim_ur10e_alumunium_table"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="sim_ur10e_base_to_screwdriver" type="fixed">
    <parent link="world"/>
    <child link="sim_ur10e_screwdriver"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="sim_ur10e_base_to_screw_feeder" type="fixed">
    <parent link="world"/>
    <child link="sim_ur10e_screw_feeder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

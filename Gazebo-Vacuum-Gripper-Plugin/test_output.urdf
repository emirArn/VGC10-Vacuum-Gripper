  <!-- base_joint fixes base_link to the environment -->
  <joint name="sim_ur10e_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="sim_ur10e_robot_mount"/>
    <child link="sim_ur10e_base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="sim_ur10e_base_link-base_link_inertia" type="fixed">
    <parent link="sim_ur10e_base_link"/>
    <child link="sim_ur10e_base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 0" xyz="0.052439 0.0768 0.05815"/>
  </joint>
  <joint name="sim_ur10e_shoulder_pan_joint" type="revolute">
    <parent link="sim_ur10e_base_link_inertia"/>
    <child link="sim_ur10e_shoulder_link"/>
    <origin rpy="0 0 0" xyz="-4e-06 0.0 0.09955"/>
    <axis xyz="0.0 -0.0 1.0"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="sim_ur10e_shoulder_lift_joint" type="revolute">
    <parent link="sim_ur10e_shoulder_link"/>
    <child link="sim_ur10e_upper_arm_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.086 0.09"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="sim_ur10e_elbow_joint" type="revolute">
    <parent link="sim_ur10e_upper_arm_link"/>
    <child link="sim_ur10e_forearm_link"/>
    <origin rpy="0 0 0" xyz="0.612099 0.021891 -0.000601"/>
    <axis xyz="0.0 1.0 -0.0"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="sim_ur10e_wrist_1_joint" type="revolute">
    <parent link="sim_ur10e_forearm_link"/>
    <child link="sim_ur10e_wrist_1_link"/>
    <origin rpy="0 0 0" xyz="0.571598 0.002 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="sim_ur10e_wrist_2_joint" type="revolute">
    <parent link="sim_ur10e_wrist_1_link"/>
    <child link="sim_ur10e_wrist_2_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.054 -0.061699"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>

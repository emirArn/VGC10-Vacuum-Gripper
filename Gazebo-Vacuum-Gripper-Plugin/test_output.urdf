  <link name="sim_ifarlab_ray_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file:///home/emirhan/colcon_ws/install/mobile_manipulator_description/share/mobile_manipulator_description/meshes/environment/ifarlab_ray.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="sim_ifarlab_ray_material">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/emirhan/colcon_ws/install/mobile_manipulator_description/share/mobile_manipulator_description/meshes/environment/ifarlab_ray.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="sim_ota_base_link">
    <origin rpy=" 0 0 0" xyz="0 0 0"/>
    <visual>
      <origin rpy=" 0 0 0" xyz="0 0 -0.1625"/>
      <geometry>
        <mesh filename="file:////home/emirhan/colcon_ws/src/mobile_manipulator_description/meshes/ota/OTA-v0.7.stl" scale="0.001 0.001 0.001"/>

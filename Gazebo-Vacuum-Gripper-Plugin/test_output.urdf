    </inertial>
  </link>
  <gazebo reference="sim_ota_base_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <material>Gazebo/Orange</material>
    <visual>
      <material>
        <ambient>0.85 0.35 0 1</ambient>

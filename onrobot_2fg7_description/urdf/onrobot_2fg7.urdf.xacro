<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="onrobot_2fg7">
    
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="port" default="502" />
    <xacro:arg name="address" default="192.168.131.5" /> <xacro:arg name="force" default="" />
    <xacro:arg name="position_filtering" default="" />
    <xacro:arg name="velocity_filtering" default="" />
    <xacro:arg name="use_fake_hardware" default="false"/>

    <!-- <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/> -->

    <xacro:include filename="$(find onrobot_2fg7_description)/urdf/onrobot_2fg7.xacro"/>
    <xacro:include filename="$(find onrobot_2fg7_description)/ros2_control/onrobot_2fg7.ros2_control.xacro"/>

    <!-- <link name="world"></link>

    <xacro:ur_robot
        name="ur10e"
        tf_prefix="ur_"
        parent="world"
        joint_limits_parameters_file="$(find ur_description)/config/ur10e/joint_limits.yaml"
        kinematics_parameters_file="$(find ur_description)/config/ur10e/default_kinematics.yaml"
        physical_parameters_file="$(find ur_description)/config/ur10e/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/ur10e/visual_parameters.yaml"
        use_fake_hardware="true"
        sim_gazebo="false"
        sim_ignition="false">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ur_robot> -->

    <link name="ur_tool0"/>

    <xacro:onrobot_2fg7 prefix="$(arg prefix)" parent="ur_tool0">
        <origin xyz="0.045576 0.040897 0.017678" rpy="0 0 0"/>
    </xacro:onrobot_2fg7>

    <xacro:onrobot_2fg7_ros2_control
        name="onrobot_2fg7"
        prefix="$(arg prefix)"
        port="$(arg port)"
        address="$(arg address)"
        force="$(arg force)"
        position_filtering="$(arg position_filtering)"
        velocity_filtering="$(arg velocity_filtering)"
        use_fake_hardware="$(arg use_fake_hardware)" />

</robot>
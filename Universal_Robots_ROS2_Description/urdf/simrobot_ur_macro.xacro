        </geometry>
      </collision>
    </link>

    <link name="${tf_prefix}cable_channel">
      <inertial>
        <origin xyz="-0.0007043985483754511 1.4782874641072752e-07 -0.030869319710005172" rpy="0 0 0"/>
        <mass value="0.4154967185204701"/>
        <inertia ixx="0.00017" iyy="0.000341" izz="0.000223" ixy="-0.0" iyz="-0.0" ixz="6e-06"/>
      </inertial>
      <visual>
        <origin xyz="-1.078132 -0.486789 -0.669752" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/secondrobotcollision/cable_channel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="-1.078132 -0.486789 -0.669752" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/secondrobotcollision/cable_channel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <joint name="${tf_prefix}cable_channel_flange-tool0" type="fixed">
      <origin xyz="0.0 0.0599 -0.01" rpy="0 0 0"/>
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}cable_channel_flange"/>
    </joint>

    <joint name="${tf_prefix}cable_channel_flange-spiral" type="fixed">
      <origin xyz="0.0 -0.051 -0.038" rpy="0 0 0"/>
      <parent link="${tf_prefix}cable_channel_flange"/>
      <child link="${tf_prefix}cable_channel"/>
    </joint>

    <link name="${tf_prefix}depth_frame"/>
    <link name="${tf_prefix}depth_optical_frame"/>
    <link name="${tf_prefix}rgb_frame"/>
    <link name="${tf_prefix}rgb_optical_frame"/>

    <joint name="${tf_prefix}depth_joint" type="fixed">
      <origin xyz="0.0 0.02 0.0" rpy="0 0 0" />
      <parent link="${tf_prefix}sick_camera" />
      <child link="${tf_prefix}depth_frame"/>
    </joint>

    <joint name="${tf_prefix}depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-${M_PI/2} -${M_PI/2} 0.0" />
      <parent link="${tf_prefix}depth_frame" />
      <child link="${tf_prefix}depth_optical_frame"/>
    </joint>

    <joint name="${tf_prefix}rgb_joint" type="fixed">
      <origin xyz="0.0 0.0125 0.0" rpy="0 0 0" />
      <parent link="${tf_prefix}sick_camera" />
      <child link="${tf_prefix}rgb_frame"/>
    </joint>

    <joint name="${tf_prefix}rgb_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-${M_PI/2} -${M_PI/2} 0.0" />
      <parent link="${tf_prefix}rgb_frame" />
      <child link="${tf_prefix}rgb_optical_frame"/>
    </joint>

     
    <xacro:if value="${sim_ignition}">
    
      <!-- Sensors system: SADECE 1 KERE -->
     <!-- <gazebo>
        <plugin filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
          <render_engine>ogre2</render_engine>
        </plugin>
      </gazebo> -->
    
      <!-- RGBD camera (depth_optical_frame linkine bağlı) -->
      <gazebo reference="${tf_prefix}depth_optical_frame">
        <sensor name="${tf_prefix}depth_optical_frame" type="rgbd_camera">
          <always_on>false</always_on>
          <update_rate>5.0</update_rate>
          <visualize>false</visualize>
    
          <camera name="${tf_prefix}rgbd">
            <horizontal_fov>1.22</horizontal_fov>
    
            <image>
              <width>512</width>
              <height>424</height>
              <format>R8G8B8</format>
            </image>
    
            <depth_image>
              <width>512</width>
              <height>424</height>
              <format>R_FLOAT32</format>
            </depth_image>

            <clip>
              <near>0.05</near>
              <far>16.0</far>
            </clip>

            <!-- Depth noise to approximate the real SICK Visionary-T Mini
                 (V3S145-1AAAAAA) time-of-flight accuracy. Datasheet
                 repeatability is ~0.8 mm at 1 m working distance (and ~5 mm at
                 7 m). SDF applies a *constant* Gaussian sigma, so we use the
                 near-range figure (0.8 mm = 0.0008 m) matching this task's
                 0.2-1.0 m inspection distances; real noise grows with range.
                 Without this the simulated point cloud is perfectly noiseless
                 and does NOT reflect the physical sensor. -->
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0008</stddev>
            </noise>
          </camera>
        </sensor>
      </gazebo>
    
      <!-- IMX179 RGB camera (IMX_Camera linkine bağlı) -->
      
    
    </xacro:if>

    <xacro:arg name="use_vacuum_gripper" default="$(optenv ENV_USE_VACUUM_GRIPPER false)"/>
    <xacro:if value="$(arg use_vacuum_gripper)">

      <link name="${tf_prefix}vacuum_gripper">
        <inertial>
          <origin xyz="0.03840935181996907 0.02553282574514726 0.01947430811837292" rpy="0 0 0"/>
          <mass value="5.206908838469105"/>
          <inertia ixx="0.007119" iyy="0.00672" izz="0.006537" ixy="0.000313" iyz="1e-06" ixz="-1e-06"/>
        </inertial>
        <visual>
          <origin xyz="-1.120802 -0.533941 -0.69825" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/secondrobotcollision/vacuum_gripper.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="silver"/>
        </visual>
        <collision>
          <origin xyz="-1.120802 -0.533941 -0.69825" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/secondrobotcollision/vacuum_gripper.stl" scale="0.001 0.001 0.001"/>
          </geometry>
        </collision>
      </link>

      <link name="${tf_prefix}suction_cup">
        <inertial>
          <origin xyz="0.047500844943701104 0.027424316463654064 -9.637760878256074e-08" rpy="0 0 0"/>
          <mass value="0.11348172115824295"/>
          <inertia ixx="2.6e-05" iyy="5.2e-05" izz="6.5e-05" ixy="-2.3e-05" iyz="0.0" ixz="-0.0"/>
        </inertial>
        <visual>
          <origin xyz="-1.19139 -0.578159 -0.71775" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/secondrobotcollision/suction_cup.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="silver"/>
        </visual>
        <collision>
          <origin xyz="-1.19139 -0.578159 -0.71775" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/secondrobotcollision/suction_cup.stl" scale="0.001 0.001 0.001"/>
          </geometry>
        </collision>
      </link>

      <joint name="${tf_prefix}vacuum_gripper_joint" type="fixed">
        <origin xyz="0.04267 0.056052 -0.0195" rpy="0 0 0"/>
        <parent link="${tf_prefix}tool0"/>
        <child link="${tf_prefix}vacuum_gripper"/>
      </joint>

      <joint name="${tf_prefix}suction_cup_joint" type="fixed">
        <origin xyz="0.070588 0.044218 0.0195" rpy="0 0 0"/>
        <parent link="${tf_prefix}vacuum_gripper"/>
        <child link="${tf_prefix}suction_cup"/>
      </joint>

      <!-- Gazebo'nun fixed joint'leri merge etmesini engelle -->
      <gazebo reference="${tf_prefix}vacuum_gripper_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
      </gazebo>
      <gazebo reference="${tf_prefix}suction_cup_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
      </gazebo>

      <gazebo>
        <plugin filename="gz-sim-contact-system"
                name="gz::sim::systems::Contact">
        </plugin>
      </gazebo>

      <gazebo reference="${tf_prefix}suction_cup">
          <sensor name="suction_contact" type="contact">
              <always_on>true</always_on>
              <update_rate>30.0</update_rate>
              <contact>
                  <collision>${tf_prefix}suction_cup_collision</collision>
              </contact>
          </sensor>
      </gazebo>

      <gazebo>
        <plugin filename="libsuction_plugin.so" name="gz::sim::v8::systems::SuctionPlugin">
            <suction_topic>/suction/enable</suction_topic>
            <link_name>${tf_prefix}suction_cup</link_name>
            <filter_name></filter_name>
            
            <use_suction_radius>false</use_suction_radius>
            
            <suction_radius>0.2</suction_radius>
            <suction_force>20.0</suction_force>
        </plugin>
      </gazebo>
      
    </xacro:if>

  </xacro:macro>
</robot>

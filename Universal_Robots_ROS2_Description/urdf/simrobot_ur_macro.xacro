        <limit upper="0.026" lower="-0.001" effort="1000" velocity="10"/>
      </joint>

      <joint name="${tf_prefix}gripper_lower_finger_joint" type="prismatic">
        <origin xyz="0.096302 0.061001 -0.067428" rpy="0 0 0"/>
        <parent link="${tf_prefix}gripper_body_1"/>
        <child link="${tf_prefix}gripper_lower_1"/>
        <axis xyz="0.0 0.0 -1.0"/>
        <mimic joint="${tf_prefix}gripper_joint" multiplier="-1.0"/>
        <!-- limits extended ±0.001 beyond nominal -0.025..0 range to work around DART servo bug (dartsim/dart#1683) -->
        <limit upper="0.001" lower="-0.026" effort="1000" velocity="10"/>
      </joint>


    </link>

    <link name="${tf_prefix}sick_camera">
      <inertial>
        <origin xyz="-0.030360308070560116 0.017381415318390325 -0.0003625735829336785" rpy="0 0 0"/>
        <mass value="2.884207514548234"/>
        <inertia ixx="0.002502" iyy="0.002303" izz="0.002674" ixy="-0.000172" iyz="1.7e-05" ixz="-6e-06"/>
      </inertial>
      <visual>
        <origin xyz="-1.02433 -0.5466 -0.730752" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/sick_camera_mo.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="-1.02433 -0.5466 -0.730752" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/sick_camera_mo.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <!-- SICK camera collision shell. The mesh above under-reports the real
           housing (its front face stops ~1.9 cm short of the physical optics
           cover), so MoveIt used to plan the camera into the UR's own joints
           and the cable channel. These six boxes wrap the housing on all
           sides: front (optics face), back, and the four sides. They are
           yawed 60 deg about the viewing axis to match the housing (same angle
           as ur_sick_optical_joint's rpy). All four neighbour links
           (flange, tool0, cable_channel, cable_channel_flange) are already
           disabled against sick_camera in every SRDF, so these boxes add no
           permanent self-collision. Front/back = 8.7 x 9.0 x 3.9 cm skirts;
           sides span the 7.75 cm housing depth. Formerly attached at runtime
           in ur_inspection_node._setup_planning_scene_extras. -->
      <collision>
        <origin xyz="-0.0301 0.0174 0.0537" rpy="0 0 1.047198"/>
        <geometry><box size="0.087 0.090 0.039"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.0301 0.0174 -0.0628" rpy="0 0 1.047198"/>
        <geometry><box size="0.087 0.090 0.039"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.0014 0.071959 -0.00455" rpy="0 0 1.047198"/>
        <geometry><box size="0.039 0.090 0.0775"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.0616 -0.037159 -0.00455" rpy="0 0 1.047198"/>
        <geometry><box size="0.039 0.090 0.0775"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.085959 0.04965 -0.00455" rpy="0 0 1.047198"/>
        <geometry><box size="0.087 0.039 0.0775"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.025759 -0.01485 -0.00455" rpy="0 0 1.047198"/>
        <geometry><box size="0.087 0.039 0.0775"/></geometry>
      </collision>
    </link>

    <link name="${tf_prefix}cable_channel_flange">
      <inertial>
        <origin xyz="4.611879362848015e-07 -0.034962924750167046 -0.015484781070814413" rpy="0 0 0"/>
        <mass value="0.0634433620618905"/>
        <inertia ixx="2.8e-05" iyy="2.6e-05" izz="2.3e-05" ixy="0.0" iyz="-1e-05" ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="-1.078132 -0.537789 -0.707752" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/cable_channel_flange.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>

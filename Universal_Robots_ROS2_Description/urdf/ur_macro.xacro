          </geometry>
        </collision>
      </link>

      <joint name="${tf_prefix}vacuum_gripper_joint" type="fixed">
        <origin xyz="0.04267 0.056052 -0.0195" rpy="0 0 0"/>
        <parent link="${tf_prefix}tool0"/>
        <child link="${tf_prefix}vacuum_gripper"/>
      </joint>

      <joint name="${tf_prefix}suction_cup_joint" type="fixed">
        <origin xyz="0.070588 0.044218 0.0195" rpy="0 0 0"/>
        <parent link="${tf_prefix}vacuum_gripper"/>

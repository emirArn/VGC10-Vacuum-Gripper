          <mass value="5.206908838469105"/>
          <inertia ixx="0.007119" iyy="0.00672" izz="0.006537" ixy="0.000313" iyz="1e-06" ixz="-1e-06"/>
        </inertial>
        <visual>
          <origin xyz="-1.120802 -0.533941 -0.69825" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/vacuum_gripper.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="silver"/>
        </visual>
        <collision>
          <origin xyz="-1.120802 -0.533941 -0.69825" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/vacuum_gripper.stl" scale="0.001 0.001 0.001"/>
          </geometry>
        </collision>
      </link>

      <link name="${tf_prefix}suction_cup">
        <inertial>
          <origin xyz="0.047500844943701104 0.027424316463654064 -9.637760878256074e-08" rpy="0 0 0"/>
          <mass value="0.11348172115824295"/>
          <inertia ixx="2.6e-05" iyy="5.2e-05" izz="6.5e-05" ixy="-2.3e-05" iyz="0.0" ixz="-0.0"/>
        </inertial>
        <visual>
          <origin xyz="-1.19139 -0.578159 -0.71775" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file:////home/emirhan/colcon_ws/src/Universal_Robots_ROS2_Description/meshes/ur10e/collision/suction_cup.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="silver"/>
        </visual>
        <collision>
          <origin xyz="-1.19139 -0.578159 -0.71775" rpy="0 0 0"/>

<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="whole_cell_hw">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="real_ur10e">
        <chain base_link="ur10e_table" tip_link="ur10e_tool0"/>
    </group>
    <group name="real_kawasaki">
        <chain base_link="ifarlab_ray_link" tip_link="link7"/>
    </group>
    <!-- The same arm WITHOUT the AGV rail, used only by the inspection executor's
         nearest-branch IK search (multirobot_viewpoint_planner, parameter
         branch_ik_group). A chain also pulls in the parent joints of its links, but
         base_link's parent joint (base_mount) is FIXED, so world_to_agv is NOT a member
         here, which is the whole point. In the 7-DOF group above KDL treats the rail
         as a free variable and drifts it: of 19 IK solutions found for viewpoint
         kawa_vp_005 only 1 kept the rail where the plan put it, so branch candidates
         were being discarded en masse. The executor pins the rail to the PLANNED value
         in every seed and re-attaches it to the dispatched goal.
         NOTE: link7 is rigid w.r.t. link6 (joint7 is fixed), so ik_link_name "link6"
         is still valid inside this group. -->
    <group name="real_kawasaki_arm">
        <chain base_link="base_link" tip_link="link7"/>
    </group>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <!-- INSPECTION TARGETS (windowdoor / windowlessdoor / platform), 2026-08-04.
         The setup assistant had written reason="Never" for 25 pairs between these three
         links and the moving links of BOTH arms, among them windowlessdoor against
         Kawasaki link4, link5 and link6, i.e. the very wrist that carries the camera.
         A disabled pair is never checked at all and link padding cannot bring it back,
         so the arms were free to sweep their cameras straight through the object they
         are meant to inspect. All 25 were REMOVED. The platform is included on purpose:
         it spans x -1.58..-0.789, y 0.013..2.533, z 0..1.75 and the Kawasaki reach
         envelope (AGV rail at x ~ -2.2 plus about 0.9 m of arm) lands right on it.
         Static clearances at the home poses were checked before removing these. -->
    <disable_collisions link1="barrier_closekabinet_link" link2="barrier_closetable_link" reason="Adjacent"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="barrier_kaw1_link" reason="Adjacent"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="barrier_kaw2_link" reason="Adjacent"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="barrier_kaw3_link" reason="Adjacent"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="barrier_link" reason="Adjacent"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="caster_back_left_link" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="caster_back_right_link" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="caster_front_left_link" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="caster_front_right_link" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="caster_wheel_back_left_link" reason="Never"/>
    <disable_collisions link1="barrier_closekabinet_link" link2="caster_wheel_back_right_link" reason="Never"/>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ota_ros2_control" params="
      name:=ota_system
      use_fake_hardware:=false
      sim_ignition:=true
      generate_ros2_control_tag:=true
      fake_sensor_commands:=false
      prefix:=''
    ">

    <xacro:if value="${generate_ros2_control_tag}">
      <ros2_control name="${name}" type="system">
        <hardware>
          <xacro:if value="${sim_ignition}">
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
          </xacro:if>

          <xacro:if value="${use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>

          <xacro:if value="${not sim_ignition and not use_fake_hardware}">
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
            <param name="joint_commands_topic">/agv/joint_cmd</param>
            <param name="joint_states_topic">/joint_states</param>
            <param name="sum_wrapped_joint_states">true</param>
          </xacro:if>
        </hardware>

        <!-- Right wheel -->
        <joint name="${prefix}wheel_right_base">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <!-- Left wheel -->
        <joint name="${prefix}wheel_left_base">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <!-- world_to_agv:
             - fake hardware → rs005l GenericSystem altında (7-DOF tek system)
             - gerçek hardware → ota_system TopicBasedSystem altında -->
        <xacro:unless value="${use_fake_hardware}">
          <joint name="${prefix}world_to_agv">
            <command_interface name="position"/>
            <command_interface name="velocity">
              <param name="min">-1.25</param>
              <param name="max">1.25</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
          </joint>
        </xacro:unless>

      </ros2_control>
    </xacro:if>

  </xacro:macro>

</robot>
